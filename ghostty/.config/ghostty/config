font-family = Maple Mono NF CN
font-family = Noto Sans Mono CJK SC
font-family = JetBrains Mono
font-size = 14

theme = Catppuccin Macchiato

background-opacity = 0.6
background-blur = 30

# fullscreen = non-native-visible-menu
maximize = true
macos-titlebar-style = tabs
# title = (<ゝω・) 綺羅星☆

confirm-close-surface = false
bell-features = no-audio,no-system

clipboard-read = allow

# ===== SSH =====
# 远端没有 xterm-ghostty 的 terminfo 时，登录会报
#   'xterm-ghostty': unknown terminal type.
# ssh-env     : 连远端时把 TERM 降级为 xterm-256color（不依赖远端任何工具）
# ssh-terminfo: 首次连接把 terminfo 传到远端并用 tic 编译，成功则继续用 xterm-ghostty
# 注意：shell 集成在 shell 启动时注入，改完要开新 tab/窗口才生效
shell-integration-features = ssh-env,ssh-terminfo

keybind = ctrl+shift+tab=next_tab
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+up=scroll_page_lines:-1
keybind = ctrl+shift+down=scroll_page_lines:1

keybind = ctrl+alt+backslash=new_split:right
keybind = ctrl+alt+slash=new_split:down
keybind = ctrl+alt+minus=close_surface
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right
